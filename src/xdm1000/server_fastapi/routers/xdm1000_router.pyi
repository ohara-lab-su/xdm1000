from typing import Optional, Any, Dict, overload
from xdm1000.server_fastapi.models.common import AutoRangeRequest, ClearRequest, ContinueCountRequest, ContinueDurationRequest, ContinueIntervalRequest, IntegrationSpeedRequest, ModeRequest, RangeRequest, WaitRequest, WaitUntilDoneRequest
from fastapi import APIRouter
class Xdm1000Router:
    """
    FastAPI Router動的生成用ベースクラス
    api_specの内容に応じて動的にhandler/routeを生やす
    """

    def __init__(self, device_instance, api_spec, logger: Optional[Any] = None, log_level: str = 'INFO'): ...
    @staticmethod
    def _model_field_names(model_cls) -> list[str]: ...
    def _extract_args_kwargs(self, api, request, target_func=None): ...
    def _resolve_callable_api(self, api, request): ...
    @staticmethod
    def _wrap_response(result, api) -> Any: ...
    def _make_handler(self, api): ...
    async def _dispatch_handler(self, request: dict): ...
    _logger: Any
    router: APIRouter
    # 現在の状態を取得する get_state()
    async def get_state(self) -> Any: ...
    # 連続測定中かどうかを取得する is_running()
    async def is_running(self) -> Any: ...
    # *IDN? を取得する idn()
    async def idn(self) -> Any: ...
    # 測定モードを設定する set_mode(mode)
    async def set_mode(self, request: Optional[ModeRequest | str] = None) -> Any: ...
    # 測定レンジを設定する set_range(range_value)
    async def set_range(self, request: Optional[RangeRequest | Union] = None) -> Any: ...
    # オートレンジを設定する set_auto_range(enabled)
    async def set_auto_range(self, request: Optional[AutoRangeRequest | bool] = None) -> Any: ...
    # 内部測定速度を設定する set_integration_speed(speed)
    async def set_integration_speed(self, request: Optional[IntegrationSpeedRequest | str] = None) -> Any: ...
    # 連続測定の測定間隔を設定する set_continue_interval(interval)
    async def set_continue_interval(self, request: Optional[ContinueIntervalRequest | float] = None) -> Any: ...
    # 連続測定の最大測定時間を設定する set_continue_duration(duration)
    async def set_continue_duration(self, request: Optional[ContinueDurationRequest | Optional] = None) -> Any: ...
    # 連続測定の最大測定回数を設定する set_continue_count(count)
    async def set_continue_count(self, request: Optional[ContinueCountRequest | Optional] = None) -> Any: ...
    # 現在設定で 1 回測定する meas(wait=None)
    async def meas(self, request: Optional[WaitRequest | Optional] = None) -> Any: ...
    # 現在設定で連続測定を開始する meas_continue(wait=None)
    async def meas_continue(self, request: Optional[WaitRequest | Optional] = None) -> Any: ...
    # 直近の単発または連続測定結果を取得する get_result(clear=False)
    async def get_result(self, request: Optional[ClearRequest | bool] = None) -> Any: ...
    # running が終わるまで待つ wait_until_done(poll_interval=0.2)
    async def wait_until_done(self, request: Optional[WaitUntilDoneRequest | float] = None) -> Any: ...