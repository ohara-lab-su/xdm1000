from typing import Optional, Any, Dict, overload
from xdm1000.server_fastapi.models.common import ClearRequest, ContinuousMeasRequest, MeasModeRequest, MeasOneShotRequest, MeasRequest, MeasSimpleRequest, StatisticsModeRequest, WaitUntilDoneRequest
from fastapi import APIRouter
class Xdm1000Router:
    """
    FastAPI Router動的生成用ベースクラス
    api_specの内容に応じて動的にhandler/routeを生やす
    """

    def __init__(self, device_instance, api_spec, logger: Optional[Any] = None, log_level: str = 'INFO'): ...
    @staticmethod
    def _model_field_names(model_cls) -> list[str]: ...
    def _extract_args_kwargs(self, api, request, target_func=None): ...
    def _resolve_callable_api(self, api, request): ...
    @staticmethod
    def _wrap_response(result, api) -> Any: ...
    def _make_handler(self, api): ...
    async def _dispatch_handler(self, request: dict): ...
    _logger: Any
    router: APIRouter
    # Get current state
    async def get_state(self) -> Any: ...
    # Get running flag
    async def is_running(self) -> Any: ...
    # Request running job stop
    async def stop_job(self) -> Any: ...
    # Get continuous measurement result
    async def get_continuous_result(self, request: Optional[ClearRequest | bool] = None) -> Any: ...
    # Get statistics mode result
    async def get_statistics_result(self, request: Optional[ClearRequest | bool] = None) -> Any: ...
    # *IDN?
    async def idn(self) -> Any: ...
    # Set measurement mode
    async def set_meas_mode(self, request: Optional[MeasModeRequest | str | Union | str] = None) -> Any: ...
    # Execute one shot measurement
    async def meas_one_shot(self, request: Optional[MeasOneShotRequest | str | Union | str | float] = None) -> Any: ...
    # Execute one shot measurement shortcut
    async def meas(self, request: Optional[MeasRequest | str | Union | str | float] = None) -> Any: ...
    # Execute DC voltage one shot measurement
    async def meas_voltage_dc(self, request: Optional[MeasSimpleRequest | Union | str] = None) -> Any: ...
    # Execute DC current one shot measurement
    async def meas_current_dc(self, request: Optional[MeasSimpleRequest | Union | str] = None) -> Any: ...
    # Start pseudo continuous measurement
    async def start_continuous_meas(self, request: Optional[ContinuousMeasRequest | str | float | Union | str | float | float] = None) -> Any: ...
    # Start statistics mode test
    async def start_statistics_mode(self, request: Optional[StatisticsModeRequest | str | float | Union | str | float] = None) -> Any: ...
    # Wait until running job is done
    async def wait_until_done(self, request: Optional[WaitUntilDoneRequest | float] = None) -> Any: ...