from __future__ import annotations

from typing import Any, Callable, Literal, overload
from xdm1000.server_fastapi.clients import AsyncXdm1000Client
from xdm1000.server_fastapi.clients import SyncXdm1000Client

@overload
def DeviceProxy(device_class: Literal['xdm1000'], *args: Any, async_mode: Literal[True], **kwargs: Any) -> AsyncXdm1000Client: ...
@overload
def DeviceProxy(device_class: Literal['xdm1000'], *args: Any, async_mode: Literal[False], **kwargs: Any) -> SyncXdm1000Client: ...
@overload
def DeviceProxy(device_class: Literal['xdm1000'], *args: Any, async_mode: None = None, **kwargs: Any) -> AsyncXdm1000Client: ...
def DeviceProxy(device_class: str, *args: Any, async_mode: bool | None = None, **kwargs: Any) -> AsyncXdm1000Client | SyncXdm1000Client: ...

def create_device_proxy(device_class: Literal['xdm1000']) -> Callable[..., AsyncXdm1000Client | SyncXdm1000Client]: ...
